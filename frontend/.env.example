# Required variables, documented for anyone cloning the repo (and for the deploy host).
#
# WARNING: every VITE_-prefixed variable is INLINED INTO THE SHIPPED BUNDLE in plain
# text and is readable by anyone who opens DevTools. Never put a secret here — there is
# no such thing as a private value in a frontend build.

# Base URL of the pasheez backend, with no trailing slash.
VITE_API_BASE_URL=http://localhost:8080
